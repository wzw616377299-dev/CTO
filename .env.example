# ============================================================
# CTO 项目环境变量模板
# 复制本文件为 .env.local 并填入真实值（.env.local 不会进 Git）
# ============================================================

# ---------- TokenHub 大模型网关（必填） ----------
# 所有 LLM 调用统一走这里
TOKENHUB_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com

# ---------- Supabase（按需） ----------
# 如果使用分析记录持久化，填入 Supabase 连接
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------- Coze SDK（按需，用于对象存储/语音/搜索） ----------
# 若不用上传、语音转写、联网搜索相关功能可留空
COZE_WORKLOAD_IDENTITY_API_KEY=
COZE_INTEGRATION_BASE_URL=
COZE_INTEGRATION_MODEL_BASE_URL=
